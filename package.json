{
  "name": "hop-ip",
  "version": "1.0.0",
  "description": "Read the visitor IP from a proxy header and ignore addresses the client added.",
  "keywords": [
    "ip",
    "client-ip",
    "x-forwarded-for",
    "forwarded",
    "proxy",
    "reverse-proxy",
    "remote-address",
    "security",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Pro Gineous <github@progineous.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progineousgb/hop-ip.git"
  },
  "homepage": "https://github.com/progineousgb/hop-ip",
  "bugs": {
    "url": "https://github.com/progineousgb/hop-ip/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test --experimental-test-coverage dist-test/test/client-ip.test.js dist-test/test/edge-cases.test.js",
    "lint:pkg": "attw --pack . && publint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.15.21",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
